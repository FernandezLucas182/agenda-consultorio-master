extends layout

block title
  | Lista de Turnos

block content
  h1 Lista de Turnos

  
  // 🔔 MENSAJES FLASH
  div#toast-container.position-fixed.top-0.end-0.p-3(style="z-index: 9999")

  // 🔍 BUSCADOR
  form(method="GET" action="/turnos" id="formFiltroTurnos")
    .row.g-2.mb-3

      .col-md-6
        input.form-control(
          type="text"
          name="q"
          placeholder="Buscar paciente, profesional o especialidad"
          value=q
        )

      .col-md-3
        input.form-control(
          type="date"
          name="fecha"
          value=fecha
        )

      .col-md-3.d-flex.gap-2
        button.btn.btn-primary(type="submit")
          | Buscar

        a.btn.btn-secondary(href="/turnos")
          | Mostrar todos

  // 🔽 BOTONES ABAJO
  div.d-flex.gap-2.mb-3
    a.btn.btn-primary(href="/turnos/nuevo") Crear nuevo turno
    a.btn.btn-secondary(href="/") Volver al inicio
  
  hr

  div.card.shadow.mb-4

    div.card-body

      if q
        div.alert.alert-info.d-flex.justify-content-between.align-items-center
          div
            | 🔎 Filtro activo:
            strong.ms-1= q

          a.btn.btn-secondary.btn-sm(
            href=`/turnos?q=${q}`
          )
            | ← Volver a resultados

      // ======================
      // SOLAPAS FILTROS
      // ======================

      ul.nav.nav-tabs.mb-2

        li.nav-item
          a.nav-link.active(href="/turnos")
            | Todos


        each esp in especialidades || []

          li.nav-item
            a.nav-link(
              href=`/turnos?q=${esp.nombre}`
            )
              = esp.nombre



      h6.mt-3 Profesionales


      ul.nav.nav-pills.mb-3

        each prof in profesionales || []

          li.nav-item

            a.nav-link(
              href=`/turnos?q=${prof.nombre_completo}`
            )
              = prof.nombre_completo



      #calendar
      

            



  div#tabla-turnos

    if turnos.length > 0
      table.table.table-striped
        thead
          tr
            th Paciente
            th Profesional
            th Especialidad
            th Sucursal
            th Fecha
            th Hora
            th Estado
            th Tipo
            th Acciones
        tbody
          
          each turno in turnos
            tr(class={
              'turno-recien-creado': turno.recienCreado,
              'turno-recien-editado': turno.recienEditado
            })
                      
            
              td= turno.paciente_nombre
              td= turno.profesional_nombre
              td= turno.especialidad_nombre
              td= turno.sucursal_nombre
              td= turno.fecha
              td= turno.hora.substring(0,5)
              td= turno.estado
              td= turno.tipo_turno || 'normal'
              td
                form(action=`/turnos/${turno.id}/eliminar`, method='POST', style='display:inline')
                  button(type='submit' class='btn btn-danger btn-sm me-1') Eliminar

                a.btn.btn-warning.btn-sm.me-1(
                  href=`/turnos/${turno.id}/editar`
                ) Editar

                a.btn.btn-info.btn-sm.me-1(
                  href=`/turnos/${turno.id}`
                ) Ver detalle

                a.btn.btn-success.btn-sm(
                  href=`/turnos?fecha=${turno.fechaISO}&q=${q || ""}`
                ) ver en📅 
    else
      p.alert.alert-info No hay turnos disponibles.

    if totalPaginas > 1
      nav.mt-4
        ul.pagination.justify-content-center

          li.page-item(class=pagina <= 1 ? 'disabled' : '')
            a.page-link(
              href=`/turnos?pagina=${pagina-1}&q=${q || ''}&fecha=${fecha || ''}`
            ) Anterior

          - for (let i = 1; i <= totalPaginas; i++)
            li.page-item(class=i === pagina ? 'active' : '')
              a.page-link(
                href=`/turnos?pagina=${i}&q=${q || ''}&fecha=${fecha || ''}`
              )= i

          li.page-item(class=pagina >= totalPaginas ? 'disabled' : '')
            a.page-link(
              href=`/turnos?pagina=${pagina+1}&q=${q || ''}&fecha=${fecha || ''}`
            ) Siguiente

    div.mt-3
      a(href='/turnos/nuevo' class="btn btn-primary") Crear nuevo turno
      a(href='/' class="btn btn-secondary ms-2") Volver al inicio



  
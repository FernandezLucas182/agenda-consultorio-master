extends layout

block title
  | Nueva Agenda

block content
  h1 Crear Agenda de Atención

  form(action="/agendas/nueva" method="POST")
    // DATOS GENERALES
    div.d-flex.justify-content-between.align-items-center.mt-4.mb-3
      h3.mb-0 Datos Generales

      button#btnRestaurar.btn.btn-warning(type="button")
        i.bi.bi-arrow-counterclockwise.me-1
        | Restaurar
    div.row.g-3
      div.col-md-6
        label.form-label(for="profesionalSelect") Profesional
        select.form-select(name="profesional_id" id="profesionalSelect" required)
          option(value="" disabled selected) -- Selecciona profesional --
          each profesional in profesionales
            option(value=profesional.id)
              | #{profesional.nombre} #{profesional.apellido}

      div.col-md-6
        label.form-label(for="especialidadSelect") Especialidad
        select.form-select(name="especialidad_id" id="especialidadSelect" required)
          option(value="" disabled selected) -- Selecciona especialidad --
          each esp in especialidades
            option(value=esp.id)= esp.nombre
      
      div.col-md-6
        label.form-label(for="sucursal_id") Sucursal
        select.form-select(name="sucursal_id" id="sucursalSelect" required)
          option(value="" disabled selected) -- Selecciona sucursal --

      div#alertaAgendaExistente.alert.alert-danger.mt-2.d-none

      div.col-md-6
        label.form-label(for="duracion_turno") Duración del turno (minutos)
        select.form-select(name="duracion_turno" id="duracion_turno" required)
          option(value="" disabled selected) -- Seleccionar duración --
          option(value="10") 10 minutos
          option(value="20") 20 minutos
          option(value="30") 30 minutos
          option(value="40") 40 minutos
          option(value="50") 50 minutos
          option(value="60") 60 minutos

      div.col-md-6
        label.form-label(for="max_sobreturnos")
          | Sobreturnos por día

        input.form-control(
          type="number"
          id="max_sobreturnos"
          name="max_sobreturnos"
          min="0"
          max="20"
          value="0"
        )

        div.form-text
          | Cantidad máxima de sobreturnos permitidos por día.

    // DISPONIBILIDAD SEMANAL (DE LUNES A SÁBADO)
    h3.mt-5.mb-3 Disponibilidad semanal

    - const dias = [{id:1,nombre:"Lunes"},{id:2,nombre:"Martes"},{id:3,nombre:"Miércoles"},{id:4,nombre:"Jueves"},{id:5,nombre:"Viernes"},{id:6,nombre:"Sábado"}]

    // Grilla Bootstrap para mostrar las tarjetas lado a lado
    div.row.g-3
      each dia in dias
        div.col-12.col-md-6.col-lg-4
          div.card.h-100.shadow-sm
            div.card-header.bg-light
              div.form-check
                input.form-check-input.check-dia(type="checkbox" data-dia=dia.id id=`check-${dia.id}`)
                label.form-check-label(for=`check-${dia.id}`)
                  strong #{dia.nombre}

            div.card-body(id=`bloques-${dia.id}`)
              //- Los bloques se agregarán aquí

            div.card-footer.bg-white.border-top-0
              button.btn.btn-outline-primary.btn-sm.w-100(type="button" onclick=`agregarBloque(${dia.id})`) + Agregar bloque horario

    div.mt-4

      button#btnGuardar.btn.btn-success.btn-lg(type="submit")
        | Guardar Agenda Completa

      a.btn.btn-secondary.btn-lg.ms-2(href="/agendas")
        | Volver

  // SCRIPT
  script.
    document.addEventListener('DOMContentLoaded', () => {

      const profesionalSelect = document.getElementById('profesionalSelect');
      const btnRestaurar = document.getElementById('btnRestaurar');

    
  
      const especialidadSelect = document.getElementById('especialidadSelect');
      const sucursalSelect = document.getElementById('sucursalSelect');
      const btnGuardar = document.getElementById('btnGuardar');
      const alertaAgendaExistente = document.getElementById('alertaAgendaExistente');

      const profesionalesOriginales = profesionalSelect.innerHTML;

      const especialidadesOriginales = especialidadSelect.innerHTML;

     
      const horariosDisponibles = [
        "09:00","09:30","10:00","10:30","11:00","11:30",
        "12:00","12:30","13:00",
        "16:00","16:30","17:00","17:30","18:00","18:30",
        "19:00","19:30","20:00","20:30","21:00"
      ];

      let actualizando = false;
      let sincronizando = false;
      let bloqueIndex = 0;

      
      
    //=========================
    //Verificar disponibilidad
    //=========================
      async function verificarDisponibilidad() {
      const profesionalId = profesionalSelect.value;
      const especialidadId = especialidadSelect.value;
      const sucursalId = sucursalSelect.value;

      if (!profesionalId || !especialidadId || !sucursalId) {
        return;
      }

      const res = await fetch(
        `/agendas/disponibilidad/${profesionalId}/${especialidadId}/${sucursalId}`
      );

        const data = await res.json();

        if (!data.disponible) {
          btnGuardar.disabled = true;
          alertaAgendaExistente.classList.remove('d-none');
          alertaAgendaExistente.innerHTML =
            "Ya existe una agenda activa para este profesional, especialidad y sucursal.";
        } else {
          btnGuardar.disabled = false;
          alertaAgendaExistente.classList.add('d-none');
        }
      }

      // =========================
      // SUCURSALES (SOLO 1 VEZ)
      // =========================
      async function cargarSucursales() {
        try {
          const res = await fetch('/sucursales');
          const sucursales = await res.json();

          sucursalSelect.innerHTML =
            '<option value="" disabled selected>-- Selecciona sucursal --</option>';

          sucursales.forEach(s => {
            const option = document.createElement('option');
            option.value = s.id;
            option.textContent = s.nombre;
            sucursalSelect.appendChild(option);
          });

        } catch (err) {
          console.error("Error sucursales:", err);
        }
      }

      cargarSucursales();

      // =========================
      // DISPONIBILIDAD
      // =========================
      
      // =========================
      // CARGAR ESPECIALIDADES
      // =========================
      async function cargarEspecialidades(profesionalId, conservar = "") {

        sincronizando = true;

        especialidadSelect.disabled = true;

        especialidadSelect.innerHTML =
          '<option selected>Cargando...</option>';

        try {

          const res =
            await fetch(`/profesionales/${profesionalId}/especialidades`);

          const especialidades =
            await res.json();

          especialidadSelect.innerHTML =
            '<option value="">-- Selecciona especialidad --</option>';

          especialidades.forEach(e => {

            const option = document.createElement("option");

            option.value = e.id;

            option.textContent = e.nombre;

            if (String(e.id) === String(conservar))
              option.selected = true;

            especialidadSelect.appendChild(option);

          });

          if (
            !conservar &&
            especialidades.length === 1
          ) {
            especialidadSelect.value =
              especialidades[0].id;
          }

        } catch (err) {

          console.error(err);

        }

        especialidadSelect.disabled = false;

        sincronizando = false;

        verificarDisponibilidad();

      }


      // =========================
      // CARGAR PROFESIONALES
      // =========================
      async function cargarProfesionales(especialidadId, conservar = "") {

        sincronizando = true;

        profesionalSelect.disabled = true;

        profesionalSelect.innerHTML =
          '<option selected>Cargando...</option>';

        try {

          const res =
            await fetch(`/profesionales/especialidad/${especialidadId}`);

          const profesionales =
            await res.json();

          profesionalSelect.innerHTML =
            '<option value="">-- Selecciona profesional --</option>';

          profesionales.forEach(p => {

            const option = document.createElement("option");

            option.value = p.id;

            option.textContent = p.nombre_completo

            if (String(p.id) === String(conservar))
              option.selected = true;

            profesionalSelect.appendChild(option);

          });

          if (
            !conservar &&
            profesionales.length === 1
          ) {

            profesionalSelect.value =
              profesionales[0].id;

          }

        } catch (err) {

          console.error(err);

        }

        profesionalSelect.disabled = false;

        sincronizando = false;

        verificarDisponibilidad();

      }


      // =========================
      // PROFESIONAL
      // =========================
      profesionalSelect.addEventListener("change", async () => {

        if (sincronizando) return;

        const profesionalId =
          profesionalSelect.value;

        const especialidadActual =
          especialidadSelect.value;

        if (!profesionalId) return;

        await cargarEspecialidades(
          profesionalId,
          especialidadActual
        );

      });


      // =========================
      // ESPECIALIDAD
      // =========================
      especialidadSelect.addEventListener("change", async () => {

        if (sincronizando) return;

        const especialidadId =
          especialidadSelect.value;

        const profesionalActual =
          profesionalSelect.value;

        if (!especialidadId) return;

        await cargarProfesionales(
          especialidadId,
          profesionalActual
        );

      });


      // =========================
      // SUCURSAL
      // =========================
      sucursalSelect.addEventListener(
        "change",
        verificarDisponibilidad
      );


      // =========================
      // RESTAURAR
      // =========================
      btnRestaurar.addEventListener("click", () => {

        sincronizando = true;

        profesionalSelect.innerHTML = profesionalesOriginales;
        especialidadSelect.innerHTML = especialidadesOriginales;

        sucursalSelect.selectedIndex = 0;

        btnGuardar.disabled = false;

        alertaAgendaExistente.classList.add("d-none");

        sincronizando = false;

      });
      // =========================
      // BLOQUES HORARIOS
      // =========================
      window.agregarBloque = function(dia) {
        const contenedor = document.getElementById('bloques-' + dia);
        const options = horariosDisponibles
          .map(h => `<option value="${h}">${h}</option>`)
          .join('');

        const div = document.createElement('div');
        div.className = 'd-flex align-items-center gap-1 mb-2 bg-light p-2 rounded border';

        div.innerHTML = `
          <input type="hidden" name="horarios[${bloqueIndex}][dia]" value="${dia}">
          <select class="form-select form-select-sm" name="horarios[${bloqueIndex}][desde]" required>
            <option value="">Desde</option>${options}
          </select>
          <span class="text-muted">-</span>
          <select class="form-select form-select-sm" name="horarios[${bloqueIndex}][hasta]" required>
            <option value="">Hasta</option>${options}
          </select>
          <button type="button" class="btn btn-outline-danger btn-sm px-2" onclick="this.parentElement.remove()">
            &times;
          </button>
        `;

        contenedor.appendChild(div);
        bloqueIndex++;
      };

    });
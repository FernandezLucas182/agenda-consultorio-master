extends layout

block title
  | Mis Turnos

block content
  h1 Mis Turnos

  // 🔔 MENSAJES FLASH
  div#toast-container.position-fixed.top-0.end-0.p-3(style="z-index: 9999")

  // 🔍 BUSCADOR
  form(method="GET" action="/mis-turnos")
    input(
      type="hidden"
      name="especialidad"
      value=especialidadId
    )
    .row.g-2.mb-3

      .col-md-6
        input.form-control(
          type="text"
          name="q"
          placeholder="Buscar paciente o especialidad"
          value=q
        )

      .col-md-3
        input.form-control(
          type="date"
          name="fecha"
          value=fecha
        )

      .col-md-3.d-flex.gap-2
        button.btn.btn-primary(type="submit")
          | Buscar

        a.btn.btn-secondary(href="/mis-turnos")
          | Mostrar todos

  // 🔽 BOTONES
  div.d-flex.gap-2.mb-3
    a.btn.btn-secondary(href="/") Volver al inicio

  // =================
  // FILTRO ESPECIALIDAD
  // =================

  div.mb-3

    a.btn.me-2(
      class=!especialidadId ? "btn-primary" : "btn-outline-primary"
      href="/mis-turnos"
    )
      | Todas


    each esp in especialidades
      a.btn.me-2(
        class=Number(especialidadId) === esp.id ? "btn-primary" : "btn-outline-primary"
        href=`/mis-turnos?especialidad=${esp.id}`
      )
        = esp.nombre

  hr

  div.card.shadow.mb-4
    div.card-body
      #calendar
      
  if totalPaginas > 1
    nav.mb-3
      ul.pagination.justify-content-center

        if pagina > 1
          li.page-item
            a.page-link(
              href=`?pagina=${pagina-1}&q=${q || ''}&fecha=${fecha || ''}&especialidad=${especialidadId || ''}`
            ) ← Anterior

        - for (let i = 1; i <= totalPaginas; i++)
          li.page-item(class=pagina === i ? 'active' : '')
            a.page-link(
              href=`?pagina=${i}&q=${q || ''}&fecha=${fecha || ''}&especialidad=${especialidadId || ''}`
            )= i

        if pagina < totalPaginas
          li.page-item
            a.page-link(
              href=`?pagina=${pagina+1}&q=${q || ''}&fecha=${fecha || ''}&especialidad=${especialidadId || ''}`
            ) Siguiente →
    

  if turnos.length > 0
    table.table.table-striped
      thead
        tr
          th Paciente
          th Especialidad
          th Fecha
          th Hora
          th Estado
          th Tipo
          th Acciones

      tbody

        each turno in turnos
          tr(class={
            'turno-recien-creado': turno.recienCreado,
            'turno-recien-editado': turno.recienEditado
          })

            td= turno.paciente_nombre
            td= turno.especialidad_nombre
            td= turno.fecha
            td= turno.hora.substring(0,5)
            td= turno.estado
            td= turno.tipo_turno || 'normal'

            td

              a.btn.btn-info.btn-sm.me-1(
                href=`/turnos/${turno.id}`
              )
                | Ver detalle

              a.btn.btn-success.btn-sm(
                href=`/mis-turnos?fecha=${turno.fechaISO}&q=${q || ""}`
              )
                | Ver en 📅

  else
    p.alert.alert-info No hay turnos disponibles.

  if totalPaginas > 1
    nav.mt-4
      ul.pagination.justify-content-center

        if pagina > 1
          li.page-item
            a.page-link(
              href=`?pagina=${pagina-1}&q=${q || ''}&fecha=${fecha || ''}&especialidad=${especialidadId || ''}`
            ) ← Anterior

        - for (let i = 1; i <= totalPaginas; i++)
          li.page-item(class=pagina === i ? 'active' : '')
            a.page-link(
              href=`?pagina=${i}&q=${q || ''}&fecha=${fecha || ''}&especialidad=${especialidadId || ''}`
            )= i

        if pagina < totalPaginas
          li.page-item
            a.page-link(
              href=`?pagina=${pagina+1}&q=${q || ''}&fecha=${fecha || ''}&especialidad=${especialidadId || ''}`
            ) Siguiente →

  div.mt-3
    a(href='/' class="btn btn-secondary") Volver al inicio
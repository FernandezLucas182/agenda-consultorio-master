extends layout

block title
  | Agenda de Consultorios

block content

  h1.mb-4 Agenda de Atención

  // 🔍 BUSCADOR
  div.d-flex.gap-2.mb-3

    form(
      method="GET"
      action="/agendas"
      style="flex:1; display:flex; gap:8px;"
    )

      input.form-control(
        type="text"
        name="buscar"
        placeholder= usuario && usuario.rol === 'medico'
          ? "Buscar por especialidad o sucursal"
          : "Buscar por profesional, especialidad o sucursal"
        value=buscar
      )

      button.btn.btn-primary(type="submit") Buscar

    a.btn.btn-secondary(href="/agendas") Mostrar todos

  div.d-flex.gap-2.mb-4

    if !usuario || usuario.rol !== 'medico'
      a.btn.btn-primary(href="/agendas/nueva") + Crear Agenda

    a.btn.btn-secondary(href="/") Volver al inicio

  - const dias = ['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo']

  if agendas.length > 0

    style.
      .turno-recien-creado-agenda {
        background-color: #d1e7dd !important; /* Verde claro estilo Bootstrap */
        border-left: 5px solid #198754 !important; /* Borde verde lateral */
        box-shadow: 0 0 10px rgba(25, 135, 84, 0.3);
      }

    each ag in agendas
      - const esNueva = (ag.id == nuevaAgendaId || ag.agenda_id == nuevaAgendaId)

      div.mt-3.px-2.py-1.rounded(
        class=(esNueva ? 'turno-recien-creado-agenda' : '')
        style= esNueva ? '' : "background:#e8f1ff; border-left:3px solid #0d6efd; margin-bottom:1px; display:flex; justify-content:space-between; align-items:center;"
      )

        span.fw-semibold
          = ag.profesional
          if esNueva
            span.badge.bg-success.ms-2 ¡Editada / Creada!

        if !usuario || usuario.rol !== 'medico'

          div.d-flex.align-items-center.gap-2

            if ag.esta_transferida
              button.btn.btn-secondary.btn-sm(
                type="button"
                disabled
                title="Esta agenda ya ha sido transferida a otro profesional"
              )
                i.bi.bi-lock-fill.me-1
                | Transferida
            else
              a.btn.btn-warning.btn-sm(
                href=`/agendas/${ag.agenda_id || ag.id}/transferir`
                title="Transferir agenda completa a otro profesional"
              )
                i.bi.bi-arrow-left-right.me-1
                | Transferir

            a.btn.btn-warning.btn-sm(
              href=`/agendas/${ag.agenda_id || ag.id}/editar`
            )
              i.bi.bi-pencil.me-1
              | Editar

      table.table.table-striped.table-bordered.table-sm.mt-0(
        class=(esNueva ? 'border-success' : '')
      )

        thead(class=(esNueva ? 'table-success text-dark' : 'table-dark'))
          tr
            th Especialidad
            th Día
            th Desde
            th Hasta
            th Duración
            th Máx. Sobreturnos
            th Sucursal

        tbody
          each item in ag.filas
            tr
              td= item.especialidad
              td= dias[item.dia_semana - 1]
              td= item.hora_inicio
              td= item.hora_fin
              td= item.duracion_turno
              td= item.max_sobreturnos
              td= item.sucursal || 'Sin sucursal'

              

  else

    p.alert.alert-info No hay agendas cargadas.